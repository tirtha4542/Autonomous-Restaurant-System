# apps/ai — local dev environment. Copy to .env. Never commit a filled .env.

ENVIRONMENT=dev

AI_SERVICE_NAME=apps-ai
AI_AGENT_DEFAULT_ID=waiter_ai_v1

# --- Internal platform boundary ---
INTERNAL_API_BASE_URL=http://localhost:3000/internal
INTERNAL_API_SERVICE_TOKEN=

# --- Model provider: Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cache / conversation state ---
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=info

# Set to false once apps/api implements the 5 contract routes documented
# in internal_client.py. Until then this runs fully standalone.
DEV_MODE_MOCK_BACKEND=true
