# apps/api — local development environment. Copy to .env. Never commit .env.

NODE_ENV=development
PORT=3000

# --- Database ---------------------------------------------------------------
# Fill in your actual local Postgres credentials. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tavonza?schema=public

# --- Auth --------------------------------------------------------------------
# Generate a real secret for local dev, e.g.: openssl rand -base64 48
# In staging/production this comes from AWS Secrets Manager/SSM, never
# committed (RULES.md #16).
JWT_SECRET=replace-with-a-long-random-local-dev-secret
JWT_EXPIRES_IN=15m

# --- Internal boundary used by apps/ai --------------------------------------
# This is the token apps/ai sends as its service-to-service credential.
# Keep this value in sync with apps/ai's INTERNAL_API_SERVICE_TOKEN.
INTERNAL_API_SERVICE_TOKEN=replace-with-a-shared-dev-secret
